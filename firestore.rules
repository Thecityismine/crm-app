rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && uid == request.auth.uid;
    }

    // Memories are personal. Family moments and client moments share one
    // collection separated only by a `kind` field, so every document is scoped
    // to the person who wrote it — not to "any signed-in user" the way the rest
    // of the CRM is.
    //
    // This is only meaningful because the general rules below deliberately stop
    // matching /memories. Firestore evaluates EVERY matching rule and grants
    // access if ANY of them allows, so a broad rule cannot be narrowed by a
    // more specific one — a recursive `/{document=**}` here would silently
    // re-open everything this block locks down.
    match /memories/{memoryId} {
      allow read, delete: if isOwner(resource.data.ownerId);
      allow create: if isOwner(request.resource.data.ownerId);
      // Both sides checked, so a memory can't be handed to another owner.
      allow update: if isOwner(resource.data.ownerId)
                    && isOwner(request.resource.data.ownerId);
    }
    // Nothing nested under a memory is granted here, and the general rules
    // below skip /memories entirely, so subcollections are denied by default.
    // Write a rule for one when there is one.

    // Users can only read/write their own data
    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // All authenticated users can read/write CRM data.
    // TODO: Add team-based rules once teams are implemented
    //
    // Written as two explicit levels rather than `/{document=**}` so the
    // `collection != 'memories'` guard actually holds — a recursive wildcard
    // would match memories too and grant everyone access to them.
    match /{collection}/{docId} {
      allow read, write: if signedIn() && collection != 'memories';
    }
    match /{collection}/{docId}/{rest=**} {
      allow read, write: if signedIn() && collection != 'memories';
    }
  }
}
